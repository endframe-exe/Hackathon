# PhishGuard AI Environment Configuration

PROJECT_NAME="PhishGuard AI"
VERSION="1.0.0"
API_PREFIX="/api"
ENVIRONMENT="development"
DEBUG=true

# Security
SECRET_KEY="phishguard-ai-development-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# MySQL 8.4 Persistence Layer (FR-04)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=phishguard_db
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/phishguard_db
ENABLE_HISTORY=true

# Threat Intelligence (VirusTotal API v3 - FR-01)
VIRUSTOTAL_API_KEY=your_vt_api_key_here
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT_SECONDS=5.0
